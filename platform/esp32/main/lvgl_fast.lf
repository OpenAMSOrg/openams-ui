# LVGL's per-pixel software drawing, run from IRAM instead of flash: the
# display draws RGB565, so the RGB565 blend, the generic blend and fill, and
# the masks (rounded corners, rings) are where every frame's time goes. From
# flash each cache miss stalls the loop; from IRAM it never does. About 24 KB
# of the 34 KB IRAM left.
#
# noflash_text moves only the code. The files' constant data stays in flash:
# it is their error-log and assert strings and function names (the blends
# keep no lookup tables), which the drawing loop never reads; in RAM they
# took 600-800 bytes of static DRAM, more the longer the build directory's
# path ("noflash" moves both).
[mapping:lvgl_fast]
archive: liblvgl.a
entries:
    lv_draw_sw_blend_to_rgb565 (noflash_text)
    lv_draw_sw_blend (noflash_text)
    lv_draw_sw_fill (noflash_text)
    lv_draw_sw_mask (noflash_text)
    lv_draw_sw_mask_rect (noflash_text)
