    "host": {
      "$comment": "The host theme (UNIFIED_UI 6): the card is the host's, so surfaces and text tints are alphas over it. surface-2 (unit cards, buttons, dialogs) darkens the card, as the dark theme's cards sit darker than its panel; a light host overrides it back to a 5 % foreground tint (OpenamsView.vue). The status colors are mixed with the foreground, so they read on a dark and on a light card; a host that sets its own (Mainsail's Vuetify palette) overrides them. Contrast checked at 4.5:1 on both cards (web/vue/tests/a11y.spec.ts).",
      "bg": "transparent",
      "surface-1": "transparent",
      "surface-2": "rgba(0, 0, 0, 0.35)",
      "surface-3": "color-mix(in srgb, currentColor 8%, transparent)",
      "line": "color-mix(in srgb, currentColor 10%, transparent)",
      "text-muted": "color-mix(in srgb, currentColor 82%, transparent)",
      "text-faint": "color-mix(in srgb, currentColor 68%, transparent)",
      "pill-bg": "color-mix(in srgb, currentColor 6%, transparent)",
      "pill-text": "currentColor",
      "heat-bg": "rgba(255,122,61,0.16)",
      "heat-text": "color-mix(in srgb, #e0561a 60%, currentColor)",
      "warn": "color-mix(in srgb, #c98a06 60%, currentColor)",
      "error": "color-mix(in srgb, #d6334a 60%, currentColor)"
    }
